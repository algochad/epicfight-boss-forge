package {{PACKAGE}}.rendertest;

import java.util.Locale;

import net.minecraft.client.CameraType;
import net.minecraft.client.Minecraft;
import net.minecraft.client.Screenshot;
import net.minecraft.world.InteractionHand;
import net.minecraftforge.api.distmarker.Dist;
import net.minecraftforge.event.TickEvent;
import net.minecraftforge.eventbus.api.SubscribeEvent;
import net.minecraftforge.fml.common.Mod;
import yesman.epicfight.api.animation.Joint;
import yesman.epicfight.api.client.camera.EpicFightCameraAPI;
import yesman.epicfight.api.client.forgeevent.PrepareModelEvent;
import yesman.epicfight.api.utils.math.OpenMatrix4f;
import yesman.epicfight.client.world.capabilites.entitypatch.player.LocalPlayerPatch;
import yesman.epicfight.config.ClientConfig;
import yesman.epicfight.world.capabilities.EpicFightCapabilities;
import yesman.epicfight.world.capabilities.entitypatch.LivingEntityPatch;

/**
 * Generated by `bossforge render-test` into a THROWAWAY COPY of the project. Never part of the real mod.
 * Joins the template world, summons the boss in open air, photographs it from several angles and reports which
 * Epic Fight mesh was actually used (RT_MESH), so a wrong renderer is detected instead of silently shipped.
 *
 * Views 1-3 are the Epic Fight target-guide diagnostics, close-up of the boss under the crosshair with the GUI visible
 * (Epic Fight draws its red outline, target marker and floating health bar only then): 1 = defaults, 2 = after the boss
 * took a little damage with the player in Epic Fight mode, 3 = the guides switched off at runtime. Views 4-8 are the
 * clean body shots (guides off, GUI hidden): front, front right, front left, back, close-up. Views 9-13 look at the
 * boss's right hand (the held weapon) from the front, the right side, the back and two three-quarter angles.
 * The last views put the boss's main weapon in the PLAYER's hand (same item model, so the same display transform)
 * and photograph the player in Epic Fight mode from the front and the back (third person), in vanilla mode, and in
 * first person with the hotbar visible (the weapon's inventory icon). They are skipped when the boss has no weapon.
 * Every shot prints RT_VIEW (name), RT_ENTITY, RT_HELD, RT_GLOW (glow flag, team, EF highlight verdict), RT_ANIM
 * (living animations Epic Fight plays) and RT_POSE (Epic Fight's own joint matrices, so a held-item placement
 * computed offline can be compared with the real thing).
 */
@Mod.EventBusSubscriber(modid = "{{MOD_ID}}", bus = Mod.EventBusSubscriber.Bus.FORGE, value = Dist.CLIENT)
public class RenderTest {
    private static final String BOSS = "{{MOD_ID}}:{{BOSS_ID}}";
    private static final String WEAPON = "{{WEAPON_ID}}".isEmpty() ? "" : "{{MOD_ID}}:{{WEAPON_ID}}";
    // boss at (0.5, 272, 8.5) above the cloud layer, facing -z (toward the front camera); its right hand is on the +x side.
    // A view is {camera eye dx, dy, dz, target dx, dy, dz}: offsets in blocks from the boss's feet for a 2.5 block tall
    // boss, multiplied by the boss's real height / 2.5 so tall bosses are framed like small ones.
    private static final double BX = 0.5, BY = 272.0, BZ = 8.5, EYE = 1.62;
    private static final double[] BODY = {0.0, 1.2, 0.0};
    private static final double[] HAND = {0.55, 1.4, 0.35};
    private static final String[] NAMES = {"outline-on", "outline-hurt", "outline-off", "front", "front-right", "front-left", "back",
        "close-up", "hand-front", "hand-side", "hand-back", "hand-3q", "hand-3q-high"};
    private static final double[][] VIEWS = {
        {0.0, 1.3, -4.3, BODY[0], BODY[1], BODY[2]},          // Epic Fight's target highlight ON: the crosshair is on the boss (GUI visible)
        {0.0, 1.3, -4.3, BODY[0], BODY[1], BODY[2]},          // the same after the boss took damage: Epic Fight's health bar and target marker
        {0.0, 1.3, -4.3, BODY[0], BODY[1], BODY[2]},          // the same with the guides switched off (see GUIDES_OFF_FROM)
        {0.0, 1.4, -8.0, BODY[0], BODY[1], BODY[2]},          // front
        {4.5, 1.4, -4.0, BODY[0], BODY[1], BODY[2]},          // front right
        {-4.5, 1.4, -4.0, BODY[0], BODY[1], BODY[2]},         // front left
        {0.0, 1.4, 8.0, BODY[0], BODY[1], BODY[2]},           // back
        {0.0, 1.3, -4.3, BODY[0], BODY[1], BODY[2]},          // close up
        {0.6, 1.6, -3.4, HAND[0], HAND[1], HAND[2]},          // right hand / weapon, from the front
        {4.2, 1.6, 0.3, HAND[0], HAND[1], HAND[2]},           // from the boss's right side
        {0.6, 1.6, 4.2, HAND[0], HAND[1], HAND[2]},           // from behind
        {3.0, 1.7, -2.6, HAND[0], HAND[1], HAND[2]},          // front right three-quarter
        {2.2, 3.1, -2.2, HAND[0], HAND[1] + 0.1, HAND[2]},    // from above (shows the lean)
    };
    // Epic Fight's target highlight, marker and health bar only appear under the crosshair and while the GUI is visible, so
    // views 1-3 (the guide diagnostics) keep Epic Fight's defaults, show the GUI and come first; every later view runs with
    // the guides off and the GUI hidden, so the model shots are clean silhouettes.
    private static final int HURT_AT = 1;            // this view is taken after the boss took a little damage, with the player in Epic Fight mode
    private static final int GUIDES_OFF_FROM = 2;    // views from this index on run with Epic Fight's target guides off
    // shots of the player holding the boss's weapon, after the boss views (skipped without a weapon)
    private static final String[] PLAYER_NAMES = {"player-front", "player-back", "player-vanilla-front", "player-first-person"};
    private static final double[] PLAYER_SPOT = {0.5, 272.0, 40.5};   // the player stands on a stone platform one block below

    private static int ticks;
    private static boolean meshLogged;
    private static LivingEntityPatch<?> bossPatch;
    private static boolean weaponGiven;
    private static int view;
    private static int stage;
    private static int wait;

    /** Camera for a view: the tp target {x, feet y, z, yaw, pitch} in Minecraft's convention (yaw 0 = +z, 90 = -x). */
    private static double[] camera(double[] v, double height) {
        double k = Math.max(height, 1.0) / 2.5;
        double cx = BX + v[0] * k, cy = BY + v[1] * k, cz = BZ + v[2] * k;
        double dx = BX + v[3] * k - cx, dy = BY + v[4] * k - cy, dz = BZ + v[5] * k - cz;
        double yaw = Math.toDegrees(Math.atan2(-dx, dz));
        double pitch = -Math.toDegrees(Math.atan2(dy, Math.sqrt(dx * dx + dz * dz)));
        return new double[] {cx, cy - EYE, cz, yaw, pitch};
    }

    private static String f(double v) {
        return String.format(Locale.ROOT, "%.3f", v);
    }

    private static String fmt(OpenMatrix4f m) {
        return f(m.m00) + "," + f(m.m01) + "," + f(m.m02) + "," + f(m.m03) + "," + f(m.m10) + "," + f(m.m11) + "," + f(m.m12) + ","
            + f(m.m13) + "," + f(m.m20) + "," + f(m.m21) + "," + f(m.m22) + "," + f(m.m23) + "," + f(m.m30) + "," + f(m.m31) + ","
            + f(m.m32) + "," + f(m.m33);
    }

    private static void logGlow(int n, net.minecraft.world.entity.Entity ent) {
        System.out.println("RT_GLOW view=" + n + " glowing=" + ent.isCurrentlyGlowing() + " glowTag=" + ent.hasGlowingTag()
            + " team=" + ent.getTeam() + " highlight=" + EpicFightCameraAPI.getInstance().shouldHighlightTarget(ent)
            + " focus=" + EpicFightCameraAPI.getInstance().getFocusingEntity() + " guideCfg=" + ClientConfig.enableTargetEntityGuide
            + " indicatorCfg=" + ClientConfig.showTargetIndicator + " healthBarCfg=" + ClientConfig.healthBarVisibility);
    }

    /** Position, living animations, held item capability and the joint matrices Epic Fight uses for the held item. */
    private static void logPatch(int n, net.minecraft.world.entity.Entity ent, LivingEntityPatch<?> p) {
        if (p == null) return;
        System.out.println("RT_BODY view=" + n + " pos=" + f(ent.getX()) + "," + f(ent.getY()) + "," + f(ent.getZ()) + " yRot=" + f(ent.getYRot())
            + (ent instanceof net.minecraft.world.entity.LivingEntity le ? " yBodyRot=" + f(le.yBodyRot) : ""));
        p.getAnimator().getLivingAnimations().forEach((k, v) -> System.out.println("RT_ANIM view=" + n + " " + k + " " + v.registryName()));
        System.out.println("RT_MOTION view=" + n + " living=" + p.getCurrentLivingMotion() + " composite=" + p.currentCompositeMotion);
        System.out.println("RT_CAP view=" + n + " main=" + p.getHoldingItemCapability(InteractionHand.MAIN_HAND));
        OpenMatrix4f[] poses = p.getArmature().getPoseMatrices();
        for (String j : new String[] {"Root", "Chest", "Head", "Tool_R", "Tool_L"}) {
            Joint jt = p.getArmature().searchJointByName(j);
            if (jt != null) System.out.println("RT_POSE view=" + n + " joint=" + j + " m=" + fmt(poses[jt.getId()]));
        }
    }

    /** Put the player where the boss is not, in Epic Fight or vanilla mode, with the camera for player shot `i`. */
    private static void setUpPlayerShot(Minecraft mc, int i) {
        if (!weaponGiven) {
            weaponGiven = true;
            mc.player.connection.sendCommand("item replace entity @s weapon.mainhand with " + WEAPON);
        }
        mc.player.connection.sendCommand("tp @s " + f(PLAYER_SPOT[0]) + " " + f(PLAYER_SPOT[1]) + " " + f(PLAYER_SPOT[2]) + " 180 0");
        LocalPlayerPatch pp = EpicFightCapabilities.getEntityPatch(mc.player, LocalPlayerPatch.class);
        if (pp != null) {
            if (i == 2) pp.toVanillaMode(false);
            else pp.toEpicFightMode(false);
        }
        mc.options.setCameraType(i == 1 ? CameraType.THIRD_PERSON_BACK : i == 3 ? CameraType.FIRST_PERSON : CameraType.THIRD_PERSON_FRONT);
        mc.options.hideGui = i != 3;
    }

    @SubscribeEvent
    public static void tick(TickEvent.ClientTickEvent e) {
        if (e.phase != TickEvent.Phase.END) return;
        Minecraft mc = Minecraft.getInstance();
        if (mc.player == null || mc.level == null) return;
        ticks++;
        // the window may lose focus (other apps): never let the pause menu cover the screenshots
        mc.options.pauseOnLostFocus = false;
        if (mc.screen != null) mc.setScreen(null);
        if (ticks == 20) {
            mc.player.connection.sendCommand("gamemode creative");
            mc.player.connection.sendCommand("gamerule doMobSpawning false");
            mc.player.connection.sendCommand("time set noon");
            mc.player.connection.sendCommand("effect give @s minecraft:night_vision infinite 0 true");
        }
        if (ticks == 30) mc.player.connection.sendCommand("tp @s 0.5 273.6 -0.5 0 4");
        if (ticks == 40) {
            mc.player.getAbilities().flying = true;
            mc.player.onUpdateAbilities();
        }
        // wait for the chunks around the arena to load before summoning
        if (ticks == 120) {
            // plain summon (no NBT) so finalizeSpawn runs and equips the main weapon, exactly like a sigil or spawn egg
            mc.player.connection.sendCommand("summon " + BOSS + " 0.5 272 8.5");
            mc.options.hideGui = true;
        }
        if (ticks == 123) {
            mc.player.connection.sendCommand("data merge entity @e[type=" + BOSS + ",limit=1] {NoAI:1b,NoGravity:1b,PersistenceRequired:1b}");
            mc.player.connection.sendCommand("tp @e[type=" + BOSS + ",limit=1] 0.5 272 8.5 180 0");
        }
        if (ticks >= 160) {
            int shots = VIEWS.length + (WEAPON.isEmpty() ? 0 : PLAYER_NAMES.length);
            boolean playerShot = view >= VIEWS.length;
            if (view < shots) {
                if (stage == 0) {
                    if (playerShot) {
                        setUpPlayerShot(mc, view - VIEWS.length);
                    } else {
                        double height = 2.5;
                        for (net.minecraft.world.entity.Entity ent : mc.level.entitiesForRendering()) {
                            if (ent.getType().toString().contains("{{BOSS_ID}}")) height = ent.getBbHeight();
                        }
                        double[] v = camera(VIEWS[view], height);
                        mc.options.hideGui = view > GUIDES_OFF_FROM;
                        if (view == HURT_AT) {
                            LocalPlayerPatch pp = EpicFightCapabilities.getEntityPatch(mc.player, LocalPlayerPatch.class);
                            if (pp != null) pp.toEpicFightMode(false);
                            mc.player.connection.sendCommand("damage @e[type=" + BOSS + ",limit=1] 4 minecraft:generic");
                        }
                        if (view == GUIDES_OFF_FROM) {
                            ClientConfig.enableTargetEntityGuide = false;
                            ClientConfig.showTargetIndicator = false;
                            ClientConfig.healthBarVisibility = ClientConfig.HealthBarVisibility.NONE;
                        }
                        mc.player.connection.sendCommand("tp @s " + f(v[0]) + " " + f(v[1]) + " " + f(v[2]) + " " + f(v[3]) + " " + f(v[4]));
                    }
                    stage = 1;
                    wait = 0;
                } else if (stage == 1) {
                    wait++;
                    if (playerShot && wait == 8) {
                        // a floor once the chunk is loaded, then stand on it (a flying player plays Epic Fight's creative poses, not the held-weapon one)
                        mc.player.connection.sendCommand("fill -2 271 38 3 271 43 minecraft:stone");
                    }
                    if (playerShot && wait == 14) {
                        mc.player.getAbilities().flying = false;
                        mc.player.onUpdateAbilities();
                    }
                    int found = 0;
                    String held = "none";
                    net.minecraft.world.entity.Entity boss = null;
                    for (net.minecraft.world.entity.Entity ent : mc.level.entitiesForRendering()) {
                        if (ent.getType().toString().contains("{{BOSS_ID}}")) {
                            found++;
                            boss = ent;
                            if (!playerShot && ent instanceof net.minecraft.world.entity.LivingEntity le) {
                                held = String.valueOf(net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(le.getMainHandItem().getItem()));
                            }
                        }
                    }
                    // photograph once the camera settled and the boss is tracked (give up waiting after 400 ticks)
                    if (wait >= (playerShot ? 70 : 40) && (found > 0 || wait >= 400)) {
                        String name = playerShot ? PLAYER_NAMES[view - VIEWS.length] : NAMES[view];
                        System.out.println("RT_VIEW " + (view + 1) + " " + name);
                        System.out.println("RT_ENTITY view=" + (view + 1) + " count=" + found);
                        if (playerShot) {
                            held = String.valueOf(net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(mc.player.getMainHandItem().getItem()));
                            LocalPlayerPatch pp = EpicFightCapabilities.getEntityPatch(mc.player, LocalPlayerPatch.class);
                            System.out.println("RT_PLAYER view=" + (view + 1) + " mode=" + (pp == null ? "none" : pp.getPlayerMode()) + " camera=" + mc.options.getCameraType());
                            logPatch(view + 1, mc.player, pp);
                        } else if (boss != null) {
                            logGlow(view + 1, boss);
                            logPatch(view + 1, boss, bossPatch);
                        }
                        System.out.println("RT_HELD view=" + (view + 1) + " item=" + held);
                        Screenshot.grab(mc.gameDirectory, mc.getMainRenderTarget(), c -> System.out.println("RT_SHOT"));
                        stage = 2;
                        wait = 0;
                    }
                } else if (++wait >= 20) {
                    view++;
                    stage = 0;
                }
            } else {
                System.out.println("RT_DONE");
                mc.stop();
            }
        }
    }

    @SubscribeEvent
    public static void prepare(PrepareModelEvent e) {
        if (!e.getEntityPatch().getOriginal().getType().toString().contains("{{BOSS_ID}}")) return;
        bossPatch = e.getEntityPatch();
        if (meshLogged) return;
        meshLogged = true;
        System.out.println("RT_MESH " + e.getMesh().positions().length / 3);
    }
}
